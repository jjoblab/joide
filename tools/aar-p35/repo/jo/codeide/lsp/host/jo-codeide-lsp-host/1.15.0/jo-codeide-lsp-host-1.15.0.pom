<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>jo.codeide.lsp.host</groupId>
  <artifactId>jo-codeide-lsp-host</artifactId>
  <version>1.15.0</version>
  <packaging>aar</packaging>
  <name>Hôte LSP de CodeIDE (AAR)</name>
  <description>Hôte LSP de CodeIDE — orchestration des moteurs Java, Kotlin et XML (packs langue de jjoblab/code-lsp), branchement LSP4J in-process via cel-lsp.</description>
  <dependencies>
    <dependency>
      <groupId>jo.codeide.lsp.java</groupId>
      <artifactId>jo-codeide-lsp-java</artifactId>
      <version>1.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>jo.codeide.lsp.kotlin</groupId>
      <artifactId>jo-codeide-lsp-kotlin</artifactId>
      <version>1.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>jo.codeide.lsp.xml</groupId>
      <artifactId>jo-codeide-lsp-xml</artifactId>
      <version>1.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>jo.codeide.lsp.model</groupId>
      <artifactId>jo-codeide-lsp-model</artifactId>
      <version>1.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.github.jjoblab.codeide-tooling</groupId>
      <artifactId>protocol</artifactId>
      <version>1.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>0.22.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
      <version>0.22.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.github.jjoblab.code-editor</groupId>
      <artifactId>cel-lsp</artifactId>
      <version>3.74.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.10</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>jo.codeide.lsp.index</groupId>
      <artifactId>jo-codeide-lsp-index</artifactId>
      <version>1.15.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
      <version>1.11.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>jo.codeide.lsp.java</groupId>
      <artifactId>jo-codeide-lsp-java-ecj-art</artifactId>
      <version>1.15.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
