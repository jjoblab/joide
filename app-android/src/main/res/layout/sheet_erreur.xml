<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille d'erreur non fatale (lot L10, d'après le dialogue d'erreur de la
     référence — REF-131) : message + « Voir les détails » (dépliage de la
     trace) + Ignorer. Une FEUILLE, jamais un dialogue (règle du propriétaire). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/erreur_feuille_titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sur"
        style="@style/Txt.Xl" />

    <TextView
        android:id="@+id/erreur_feuille_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:background="@drawable/fond_carte_alerte" />

    <!-- Détails dépliables (trace monospace) -->
    <TextView
        android:id="@+id/erreur_feuille_voir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/erreur_voir_details"
        android:textColor="@color/sur_sc2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/erreur_feuille_details_zone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/fond_code"
        android:visibility="gone">

        <TextView
            android:id="@+id/erreur_feuille_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/sur_var"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/erreur_feuille_ignorer"
        style="@style/Cta"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/erreur_ignorer"
            android:textColor="@color/sur_primaire"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
