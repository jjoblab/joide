<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Structure du tiroir gauche (Lot 0) : état « à venir » honnête. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="24dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_code"
        android:importantForAccessibility="no"
        android:alpha="0.6"
        app:tint="@color/sur_var" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tiroir_structure_a_venir_title"
        android:textColor="@color/sur"
        android:textSize="@dimen/txt_med"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/tiroir_structure_a_venir_body"
        android:textColor="@color/sur_var"
        android:textSize="@dimen/txt_body_s" />
</LinearLayout>
