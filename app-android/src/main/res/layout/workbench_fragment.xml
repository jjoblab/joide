<?xml version="1.0" encoding="utf-8"?>
<!-- Atelier téléphone : barre, tiroirs (fragment), zone éditeur, bottom sheet 4 sections
     (fiche ecrans/atelier.md ; en-tête unique sans doublon, règles §3 du cahier des charges). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/workbench_toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:title="@string/atelier_titre" />

        <FrameLayout
            android:id="@+id/editor_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/colorSurface" />
    </LinearLayout>

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />

    <!-- Bottom sheet : une seule en-tête à onglets, quatre sections, aucune répétition -->
    <LinearLayout
        android:id="@+id/sections_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="56dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sections_tabs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:tabMode="scrollable">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_console" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_problemes" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_journal" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_logcat" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
