<?xml version="1.0" encoding="utf-8"?>
<!-- Éditeur (studio HTML, onglet « Éditeur », 1:1) : tiroir gauche push 320dp
     (switcher Files·Chercher·Structure), top bar 52dp (menu, nom, pill mode,
     save/undo/redo/play/dots), onglets fichiers 40dp, fil d'Ariane 34dp
     (segment code/aperçu), zone code sc_lowest, dock à 3 detents (preview
     bottom-sheet : 60dp réduit → 60% half → plein sous la toolbar), clavier
     symboles beige. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond">

    <!-- Contenu principal : poussé (translation) par l'ouverture d'un tiroir. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Colonne principale : barre + onglets + fil d'Ariane + code (le dock
         glisse par-dessus en bas, Behavior du panneau). Le padding bas réserve
         la hauteur de la barre repliée du dock (référence : le dock replié ne
         masque JAMAIS le bas de l'éditeur) — retiré pendant le clavier. -->
    <LinearLayout
        android:id="@+id/colonne_principale"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dock_replie_hauteur"
        android:background="@color/fond">

        <!-- Top bar 52dp (studio) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/sc"
            android:baselineAligned="false">

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/IconBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/atelier_arborescence"
                android:src="@drawable/ic_menu"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/project_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/sur"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/project_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/sur_var"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Puce d'indexation (référence IndexStatusChip, compact : visible
                 seulement pendant un pass — spinner + pourcentage, tap = détail) -->
            <LinearLayout
                android:id="@+id/index_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/fond_pill_primaire"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/index_chip_progress"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/index_chip_texte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/primaire"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/mode_chip"
                style="@style/Pill"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:background="@drawable/fond_pill_mode"
                android:text="@string/mode_forge_nom"
                android:textColor="@color/sur_conteneur_tertiaire"
                android:textSize="@dimen/pill_txt"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/save_button"
                style="@style/IconBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/atelier_enregistrer"
                android:src="@drawable/ic_save"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <ImageButton
                android:id="@+id/undo_button"
                style="@style/IconBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/atelier_annuler"
                android:src="@drawable/ic_undo"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <ImageButton
                android:id="@+id/redo_button"
                style="@style/IconBtn"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/atelier_refaire"
                android:src="@drawable/ic_redo"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <ImageButton
                android:id="@+id/build_button"
                style="@style/IconBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/fond_run_bouton"
                android:contentDescription="@string/atelier_construire"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                app:tint="@color/sur_conteneur_primaire" />

            <ImageButton
                android:id="@+id/dots_button"
                style="@style/IconBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/accueil_plus"
                android:src="@drawable/ic_dots"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />
        </LinearLayout>

        <!-- Bandeau unifié des avis (référence EditorNoticeStrip) : UN seul
             bandeau pour tout — un avis = sa rangée ; plusieurs = « N avis »
             dépliable. Teinte alerte 10 %, action à droite, masquable.
             Remplace l'ancienne notice de mode seule. -->
        <LinearLayout
            android:id="@+id/notice_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Rangée résumé (plusieurs avis) -->
            <LinearLayout
                android:id="@+id/notice_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/notice_icone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_options"
                    android:scaleType="centerInside"
                    app:tint="@color/alerte" />

                <TextView
                    android:id="@+id/notice_compte"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/alerte"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/notice_caret"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevr"
                    android:scaleType="centerInside"
                    app:tint="@color/alerte" />
            </LinearLayout>

            <!-- Les rangées d'avis (texte · action · masquer) -->
            <LinearLayout
                android:id="@+id/notice_rangees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Onglets de fichiers 40dp + chevron de débordement épinglé
             (référence TabsStrip : LazyRow + chevron si débordement, hairline
             sous la strip). Le chevron ouvre le menu de TOUS les fichiers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/fond">

            <HorizontalScrollView
                android:id="@+id/onglets_defile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/files_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <!-- Filet séparant les onglets qui défilent du chevron épinglé -->
            <View
                android:id="@+id/onglets_sep"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="@color/contour_var"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/onglets_debordement"
                style="@style/IconBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/atelier_onglets_debordement"
                android:src="@drawable/ic_chevd"
                android:scaleType="centerInside"
                app:tint="@color/sur_var"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Hairline sous les onglets (référence : sous la strip, pas plus bas) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/contour_var" />

        <!-- Fil d'Ariane 34dp (référence BreadcrumbBar : flèches retour/avant
             si historique, localisation qui suit le curseur — module › symboles
             englobants — tap = Structure, segment code/aperçu/scindé à droite) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/fond"
            android:baselineAligned="false">

            <ImageButton
                android:id="@+id/fil_retour"
                style="@style/IconBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:visibility="gone"
                android:contentDescription="@string/atelier_nav_retour"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <ImageButton
                android:id="@+id/fil_avant"
                style="@style/IconBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:visibility="gone"
                android:contentDescription="@string/atelier_nav_avant"
                android:src="@drawable/ic_chevr"
                android:scaleType="centerInside"
                app:tint="@color/sur_var" />

            <TextView
                android:id="@+id/breadcrumb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/sur_var" />

            <!-- Segment code/aperçu (studio : sc_high + pastille active pc) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp"
                android:background="@drawable/fond_segment_switcher">

                <ImageButton
                    android:id="@+id/segment_code"
                    android:layout_width="30dp"
                    android:layout_height="24dp"
                    android:background="@drawable/fond_segment_actif"
                    android:contentDescription="@string/atelier_vue_code"
                    android:src="@drawable/ic_code"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_conteneur_primaire" />

                <ImageButton
                    android:id="@+id/segment_apercu"
                    android:layout_width="30dp"
                    android:layout_height="24dp"
                    android:background="@null"
                    android:contentDescription="@string/atelier_vue_apercu"
                    android:src="@drawable/ic_wb"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_var" />

                <!-- Scindé (référence ViewModeToggle.Split) : code dessus,
                     aperçu dessous — empilé sur téléphone. -->
                <ImageButton
                    android:id="@+id/segment_scinde"
                    android:layout_width="30dp"
                    android:layout_height="24dp"
                    android:background="@null"
                    android:contentDescription="@string/atelier_vue_scinde"
                    android:src="@drawable/ic_scinde"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_var"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zone code (studio : sc_lowest, mono 12.5, lignes numérotées ; céleris L5) -->
        <FrameLayout
            android:id="@+id/editor_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/sc_lowest">

            <!-- Aperçu (segment droit du preview contenu-principal.html) :
                 filaire XML rendu depuis le tampon vivant, ou image (état
                 binaire). Bascule par visibilité avec l'éditeur céleris. -->
            <ScrollView
                android:id="@+id/apercu_zone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@color/sc_low"
                android:padding="12dp" />

            <!-- État honnête : aucun fichier ouvert (preview : « ouvrez-en
                 un depuis l'arbre ») + fichiers récents (référence
                 NoOpenFilesView : les 5 derniers, une tape pour rouvrir). -->
            <LinearLayout
                android:id="@+id/etat_vide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="24dp">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/fond_cadre_vide" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/atelier_vide_titre"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sur_var" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/atelier_vide_detail"
                    android:textSize="12sp"
                    android:textColor="@color/contour" />

                <!-- Récents (référence : rouvrir en une tape après tout fermer) -->
                <LinearLayout
                    android:id="@+id/etat_vide_recents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Clavier de symboles (studio : beige, rangée Tab + touches 36dp) -->
        <LinearLayout
            android:id="@+id/symbol_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/clavier"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Dock à 3 detents (preview bottom-sheet : 60dp réduit → 60 % half →
         PLEIN ÉCRAN comme la référence : la console couvre tout, seule la
         poignée — ou un glissé — replie). La colonne principale réserve
         dock_replie_hauteur en bas : replié, le dock ne masque jamais le bas
         de l'éditeur.
         Console = rendu du ConsoleBuffer (lignes colorées par nature). -->
    <FrameLayout
        android:id="@+id/dock_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fond_dock"
        app:behavior_peekHeight="60dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.6"
        app:behavior_hideable="false"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Fine ligne de progression sur le bord supérieur de la barre
             repliée pendant un build (référence BuildDock : 2dp, accent) -->
        <ProgressBar
            android:id="@+id/dock_progression"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/dock_handle"
                android:layout_width="38dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/fond_handle" />

            <!-- Barre du dock 52dp (studio : recherche, terminal, spark pc, dots badge 3, check ok) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:baselineAligned="false">

                <ImageButton
                    android:id="@+id/dock_search"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/atelier_recherche"
                    android:src="@drawable/ic_search"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_var" />

                <ImageButton
                    android:id="@+id/terminal_button"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/terminal_titre"
                    android:src="@drawable/ic_terminal"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_var" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dock_build_state"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/fond_pill_sc_highest"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/dock_etat_pret"
                    android:textColor="@color/sur_var"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/ai_button"
                    style="@style/IconBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/fond_pastille"
                    android:contentDescription="@string/ia_titre"
                    android:src="@drawable/ic_spark"
                    android:scaleType="centerInside"
                    app:tint="@color/sur_conteneur_primaire" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/dots_button_dock"
                        style="@style/IconBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/accueil_plus"
                        android:src="@drawable/ic_dots"
                        android:scaleType="centerInside"
                        app:tint="@color/sur_var" />

                    <TextView
                        android:id="@+id/dock_badge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="end|top"
                        android:gravity="center"
                        android:background="@drawable/fond_badge"
                        android:text="@string/atelier_dock_badge"
                        android:textColor="@color/conteneur_erreur"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Corps du dock (sections : pills d'état + onglets du mode + contenus) -->
            <LinearLayout
                android:id="@+id/dock_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <!-- Rangée d'état du build (studio : pills ok/err/warn + copier) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/build_state_ok"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:background="@drawable/fond_pill_ok"
                        android:textColor="@color/ok"
                        android:textSize="@dimen/pill_txt"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/build_state_err"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/fond_pill_err"
                        android:textColor="@color/erreur"
                        android:textSize="@dimen/pill_txt"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/build_state_warn"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/fond_pill_warn"
                        android:textColor="@color/alerte"
                        android:textSize="@dimen/pill_txt"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/dock_copy"
                        style="@style/IconBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/diagnostic_copier"
                        android:src="@drawable/ic_copy"
                        android:scaleType="centerInside"
                        app:tint="@color/sur_var" />
                </LinearLayout>

                <!-- Onglets du dock (Forge : Console·Problèmes·Journal·Logcat ;
                     Gradle : Console·Problèmes·Étapes·Terminal — studio, modeEditor) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dock_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp" />
                </HorizontalScrollView>

                <!-- Contenus des sections (visibles selon l'onglet actif) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Problèmes (rangées ✗/⚠/▸ + position, cliquables → fichier) -->
                    <ScrollView
                        android:id="@+id/problems_section"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/problems_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:background="@drawable/fond_sortie_dock" />
                    </ScrollView>

                    <!-- Filtre de niveau de la console (Essentiel · Détaillé · Tout) :
                         un ARGUMENT du moteur, comme les -q/-i/-d de Gradle —
                         le moteur trie à l'émission, l'atelier demande. -->
                    <LinearLayout
                        android:id="@+id/console_filter_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone" />

                    <!-- Console (sortie du build : lignes colorées par nature,
                         preview bottom-sheet — mono 10.5/1.75 sur sc_lowest) -->
                    <ScrollView
                        android:id="@+id/console_section"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <TextView
                            android:id="@+id/console_output"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="10.5sp"
                            android:lineSpacingMultiplier="1.75"
                            android:padding="10dp"
                            android:background="@drawable/fond_sortie_dock"
                            android:textColor="@color/sur_var" />
                    </ScrollView>

                    <!-- Étapes (les tâches du build en rangées d'horloge, mode Gradle) -->
                    <ScrollView
                        android:id="@+id/steps_section"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/steps_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:background="@drawable/fond_sortie_dock" />
                    </ScrollView>

                    <!-- Journal IDE (mono, sur_var) -->
                    <ScrollView
                        android:id="@+id/journal_section"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <TextView
                            android:id="@+id/ide_journal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="10.5sp"
                            android:lineSpacingMultiplier="1.75"
                            android:padding="10dp"
                            android:background="@drawable/fond_sortie_dock"
                            android:textColor="@color/sur_var" />
                    </ScrollView>

                    <!-- Logcat (mode Forge — pas encore câblé : état honnête) -->
                    <TextView
                        android:id="@+id/logcat_section"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/fond_sortie_dock"
                        android:textColor="@color/sur_var"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        style="@style/Txt.BodyS" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Tiroir gauche : LeftDrawerFragment hébergé en fragment enfant
         (Files · Chercher · Structure · Git), 320dp, pousse le contenu.
         Largeur fixée à l'exécution (min(320dp, écran − 56dp), dimens). -->
    <FrameLayout
        android:id="@+id/left_drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@color/sc"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/left_drawer_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Tiroir droit : agent IA (AiPanelFragment hébergé en fragment enfant),
         largeur fixée à l'exécution (≤ 420dp, jamais plus large que l'écran). -->
    <FrameLayout
        android:id="@+id/right_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/sc"
        android:clickable="true"
        android:focusable="true">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/ai_drawer_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
