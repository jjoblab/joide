<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Git du tiroir gauche (Lot 7) : en-tête branche + suivi +
     tirer/pousser, Changements (zones exactes + zone de commit),
     Branches, Historique, Plus (stash, .gitignore, correctifs, écran
     complet) — sections repliables, rangées construites en code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête : branche courante + suivi + synchro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/git_branch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/sur"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/git_tracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/sur_var"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/git_pull"
            style="@style/IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/git_tiroir_tirer"
            android:src="@drawable/ic_down"
            android:scaleType="centerInside"
            app:tint="@color/sur" />

        <ImageButton
            android:id="@+id/git_push"
            style="@style/IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/git_tiroir_pousser"
            android:src="@drawable/ic_up"
            android:scaleType="centerInside"
            app:tint="@color/sur" />
    </LinearLayout>

    <!-- Contenu défilant : sections repliables -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/git_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
