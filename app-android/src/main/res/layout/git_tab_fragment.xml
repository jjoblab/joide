<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Git du tiroir gauche (Lot 7, fidélité preview tiroir-gauche.html) :
     en-tête (chip branche avec sélecteur, suivi réel ↓↑ + dernière synchro,
     Fetch · Pull · Push), sous-navigation Changements · Branches ·
     Historique · Plus (chips), contenu défilant, zone de commit collée en
     bas (sujet + compteur 0/72 + Amend + Signoff) — toujours visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête : chip branche (sélecteur) + suivi + Fetch/Pull/Push -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/git_branch_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fond_chip_on"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_branche"
                android:scaleType="centerInside"
                app:tint="@color/sur_sc2" />

            <TextView
                android:id="@+id/git_branch_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/sur_sc2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevd"
                android:scaleType="centerInside"
                app:tint="@color/sur_sc2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/git_tracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/sur_var"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/git_last_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/contour"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/git_fetch"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/git_tiroir_fetch"
            android:src="@drawable/ic_fetch"
            android:scaleType="centerInside"
            app:tint="@color/sur" />

        <ImageButton
            android:id="@+id/git_pull"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/git_tiroir_tirer"
            android:src="@drawable/ic_down"
            android:scaleType="centerInside"
            app:tint="@color/sur" />

        <ImageButton
            android:id="@+id/git_push"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/git_tiroir_pousser"
            android:src="@drawable/ic_up"
            android:scaleType="centerInside"
            app:tint="@color/sur" />
    </LinearLayout>

    <!-- Sous-navigation (preview .chips-rangée) : une vue à la fois -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/git_nav_changes"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:background="@drawable/fond_chip_on"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:text="@string/git_tiroir_changements_nav"
            android:textColor="@color/sur_sc2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/git_nav_branches"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/fond_chip"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:text="@string/git_tiroir_branches"
            android:textColor="@color/sur"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/git_nav_history"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/fond_chip"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:text="@string/git_tiroir_historique_nav"
            android:textColor="@color/sur"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/git_nav_more"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/fond_chip"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:text="@string/git_tiroir_plus_nav"
            android:textColor="@color/sur"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenu de la vue active -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/git_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <!-- Zone de commit collée en bas (preview .zone-commit), visible sur
         la vue Changements uniquement : jamais cachée par le contenu. -->
    <LinearLayout
        android:id="@+id/git_commit_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sc"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fond_field"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/git_commit_subject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="text"
                android:singleLine="true"
                android:background="@null"
                android:hint="@string/git_tiroir_sujet"
                android:textColor="@color/sur"
                android:textColorHint="@color/contour"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/git_commit_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/contour"
                android:textSize="10.5sp"
                android:text="@string/git_tiroir_compteur_depart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="7dp">

            <CheckBox
                android:id="@+id/git_commit_amend"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/git_tiroir_amend"
                android:textColor="@color/sur_var"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/git_commit_signoff"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:text="@string/git_tiroir_signoff"
                android:textColor="@color/sur_var"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/git_commit_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/fond_cta"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:text="@string/git_tiroir_commit"
                android:textColor="@color/sur_primaire"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
