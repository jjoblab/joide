<?xml version="1.0" encoding="utf-8"?>
<!-- Rangée du hub Paramètres (studio : row-item — pastille 40 + t-sm + body-s
     + chevR, padding 13/16, séparateur inset 70/16). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="13dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fond_pastille"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:tint="@color/sur_conteneur_primaire" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Txt.Sm" />

        <TextView
            android:id="@+id/row_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="@color/sur_var" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevr"
        android:importantForAccessibility="no"
        app:tint="@color/sur_var" />
</LinearLayout>
