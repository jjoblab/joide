<?xml version="1.0" encoding="utf-8"?>
<!-- Création (studio HTML, onglet « Création », 1:1) : écran 2 étapes —
     galerie de modèles (recherche, chips catégories, cartes recommandées)
     puis configuration (nom, paquet, fournisseur de vues, R8, CTA). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond">

    <!-- Barre (studio : back + titre) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/create_back"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/commun_retour"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            app:tint="@color/sur_var"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/creation_titre"
            android:textColor="@color/sur"
            style="@style/Txt.Xl" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Étape 1 : galerie (studio : recherche + chips + recommandés) -->
            <LinearLayout
                android:id="@+id/create_step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <!-- Champ de recherche ÉDITABLE : le libellé vit dans le hint —
                     un TextView non éditable ferait de « Chercher un modèle… »
                     une requête de filtre permanente (galerie vide, bug réel). -->
                <EditText
                    android:id="@+id/create_search"
                    style="@style/Champ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:hint="@string/creation_chercher"
                    android:textColorHint="@color/sur_var" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/create_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="2dp"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/creation_recommandes"
                    style="@style/Txt.Eyebrow" />

                <LinearLayout
                    android:id="@+id/create_templates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Étape 2 : configuration (studio : retour + nom, paquet, vues, R8, CTA) -->
            <LinearLayout
                android:id="@+id/create_step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageButton
                        android:id="@+id/create_to_step1"
                        style="@style/IconBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-12dp"
                        android:contentDescription="@string/commun_retour"
                        android:src="@drawable/ic_back"
                        android:scaleType="centerInside"
                        app:tint="@color/sur_var"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/create_template_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sur"
                            style="@style/Txt.Xl" />

                        <TextView
                            android:id="@+id/create_template_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Txt.BodyS" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/creation_nom_label"
                    android:textColor="@color/sur"
                    style="@style/Txt.Label" />

                <EditText
                    android:id="@+id/create_name_field"
                    style="@style/Champ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:hint="@string/creation_modele_hint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/creation_paquet_label"
                    android:textColor="@color/sur"
                    style="@style/Txt.Label" />

                <EditText
                    android:id="@+id/create_package_field"
                    style="@style/Champ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:hint="@string/creation_paquet_hint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/creation_vues_label"
                    android:textColor="@color/sur"
                    style="@style/Txt.Label" />

                <LinearLayout
                    android:id="@+id/create_views"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/creation_r8_label"
                    android:textColor="@color/sur"
                    style="@style/Txt.Label" />

                <LinearLayout
                    android:id="@+id/create_r8_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/creation_r8_desc"
                        android:textColor="@color/sur"
                        style="@style/Txt.BodyS" />

                    <Switch
                        android:id="@+id/create_r8_switch"
                        android:layout_width="50dp"
                        android:layout_height="30dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <LinearLayout
                    android:id="@+id/create_go"
                    style="@style/Cta"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/creation_ok"
                        app:tint="@color/sur_primaire"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/creation_ok"
                        android:textColor="@color/sur_primaire"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/creation_derivation_note"
                    style="@style/Txt.BodyS" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
