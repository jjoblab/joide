<?xml version="1.0" encoding="utf-8"?>
<!-- Écran ONBOARDING — reconstruction exacte du studio HTML (premier
     lancement) : pages scroll centré, barre segmentée 4 segments 4dp
     (primaire vs contour_var, opacité 1/.6), zone icône 170dp rayon 26
     fond sc + icône 110dp primaire (folder/code/spark selon page), pill
     k (pc/sur_pc), titre 26sp bold 800 letter -0.4, desc 14sp, pied :
     CTA pleine largeur 64dp + lien primaire 13sp. Identifiants anglais
     (check-langue), textes en @string/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond">

    <!-- Zone pages : scroll centré verticalement -->
    <ScrollView
        android:id="@+id/onboarding_page_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- Barre segmentée : 4 segments 4dp -->
            <LinearLayout
                android:id="@+id/onboarding_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <View
                    android:id="@+id/onboarding_segment_1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@color/primaire" />

                <View
                    android:id="@+id/onboarding_segment_2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/contour_var" />

                <View
                    android:id="@+id/onboarding_segment_3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/contour_var" />

                <View
                    android:id="@+id/onboarding_segment_4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="@color/contour_var" />
            </LinearLayout>

            <!-- Zone icône : 170dp, rayon 26, fond sc, icône 110dp primaire -->
            <FrameLayout
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/fond_carte">

                <ImageView
                    android:id="@+id/onboarding_icon"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/primaire"
                    android:alpha="0.9" />
            </FrameLayout>

            <!-- Pill k (pc / sur_pc) -->
            <TextView
                android:id="@+id/onboarding_kicker"
                style="@style/Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fond_pill_pc"
                android:text="@string/onboarding_page1_kicker"
                android:textColor="@color/sur_conteneur_primaire"
                android:textSize="@dimen/txt_pill"
                android:textStyle="bold" />

            <!-- Titre : 26sp bold 800 letter -0.4 -->
            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:text="@string/onboarding_page1_title"
                android:textColor="@color/sur"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015"
                android:lineSpacingMultiplier="1.25" />

            <!-- Description : 14sp -->
            <TextView
                android:id="@+id/onboarding_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_page1_desc"
                android:textColor="@color/sur_var"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6" />
        </LinearLayout>
    </ScrollView>

    <!-- Pied : CTA pleine largeur 64dp + lien primaire 13sp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:id="@+id/onboarding_cta"
            style="@style/Cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ctah_hauteur"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onboarding_cta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_cta_next"
                android:textColor="@color/sur_primaire"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="-0.007" />
        </LinearLayout>

        <TextView
            android:id="@+id/onboarding_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/onboarding_link_skip"
            android:textColor="@color/primaire"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
