<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille « Dépôt Maven » + feuille « Éditer une dépendance » : la version
     (champ + versions publiées), la portée, la suppression (confirmation
     séparée). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/editeur_dep_coordonnee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sur"
        android:fontFamily="monospace"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/editeur_dep_sous_titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dep_editer_sous_titre"
        style="@style/Txt.BodyS" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/dep_editer_version"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <EditText
        android:id="@+id/editeur_dep_version"
        style="@style/Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <!-- Versions publiées (chargées du solr Maven Central, rendu en code) -->
    <LinearLayout
        android:id="@+id/editeur_dep_versions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/dep_portee"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/editeur_dep_portees"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:id="@+id/editeur_dep_supprimer"
            style="@style/Tonal64"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/fond_cta_erreur">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dep_supprimer_bouton"
                android:textColor="@color/sur_primaire"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editeur_dep_enregistrer"
            style="@style/Cta"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modules_enregistrer"
                android:textColor="@color/sur_primaire"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
