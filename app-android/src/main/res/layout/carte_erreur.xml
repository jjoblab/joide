<?xml version="1.0" encoding="utf-8"?>
<!-- Carte erreur (studio : conteneur erreur, rayon 14, ic_bell + titre +
     corps + chips Réessayer / Ouvrir Paramètres). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fond_carte_erreur"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_bell"
            android:importantForAccessibility="no"
            app:tint="@color/sur_conteneur_erreur" />

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_error_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/sur_conteneur_erreur"
            android:letterSpacing="-0.007" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/chat_error_body_401"
        android:textSize="12.5sp"
        android:textColor="@color/sur_conteneur_erreur"
        android:alpha="0.9"
        android:lineSpacingMultiplier="1.5" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/error_retry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/fond_chip_action"
            android:textColor="@color/sur"
            android:text="@string/chat_error_retry"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/fond_chip_outline"
            android:textColor="@color/sur_conteneur_erreur"
            android:text="@string/chat_error_open_settings"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
