<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille « Nouveau module » (lot L10) : nom, chips de type, niveau Java —
     crée les répertoires réels et inscrit le module dans forge.json. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modules_nouveau_titre"
        android:textColor="@color/sur"
        style="@style/Txt.Xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/modules_nouveau_sous_titre"
        style="@style/Txt.BodyS" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="@string/modules_nouveau_nom"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <EditText
        android:id="@+id/nouveau_module_nom"
        style="@style/Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        android:hint="@string/modules_nouveau_nom_hint" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/modules_nouveau_type"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <LinearLayout
        android:id="@+id/nouveau_module_types"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/modules_nouveau_java"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <LinearLayout
        android:id="@+id/nouveau_module_java"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/nouveau_module_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/erreur"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/nouveau_module_creer"
        style="@style/Cta"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modules_nouveau_creer"
            android:textColor="@color/sur_primaire"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
