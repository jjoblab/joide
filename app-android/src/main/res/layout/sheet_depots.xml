<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille « Dépôts Maven » (lot L10) : liste réelle de forge.json, ajout
     d'URL, chips de dépôts connus (Maven Central, Aliyun, JitPack). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/depots_titre"
        android:textColor="@color/sur"
        style="@style/Txt.Xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/depots_sous_titre"
        style="@style/Txt.BodyS" />

    <!-- Dépôts déclarés (rendu en code : URL + bouton de retrait) -->
    <LinearLayout
        android:id="@+id/depots_liste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp" />

    <!-- Dépôts connus (quick-add) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/depots_connus"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <LinearLayout
        android:id="@+id/depots_connus_row"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/depots_ajouter_url"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <EditText
        android:id="@+id/depots_url"
        style="@style/Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:hint="@string/depots_url_hint" />

    <TextView
        android:id="@+id/depots_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/erreur"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/depots_ajouter_bouton"
        style="@style/Cta"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/depots_ajouter_bouton"
            android:textColor="@color/sur_primaire"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
