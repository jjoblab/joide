<?xml version="1.0" encoding="utf-8"?>
<!-- Écran git (studio HTML gitScreen) : barre, carte statut, fichiers + diff
     coloré, historique, commit, clonage. Identifiants anglais, textes @string/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond">

    <!-- Barre sticky : back, titre t-xl, down (pull), share (push) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/fond"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/git_back_button"
            style="@style/IconBtn"
            android:layout_width="@dimen/iconbtn_cote"
            android:layout_height="@dimen/iconbtn_cote"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/commun_retour"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/git_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/git_title"
            android:textColor="@color/sur"
            style="@style/Txt.Xl" />

        <ImageButton
            android:id="@+id/git_pull_button"
            style="@style/IconBtn"
            android:layout_width="@dimen/iconbtn_cote"
            android:layout_height="@dimen/iconbtn_cote"
            android:contentDescription="@string/git_pull"
            android:scaleType="centerInside"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/git_push_button"
            style="@style/IconBtn"
            android:layout_width="@dimen/iconbtn_cote"
            android:layout_height="@dimen/iconbtn_cote"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/git_push"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- État « pas un dépôt » : honnête, jamais muet -->
            <LinearLayout
                android:id="@+id/git_missing_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="36dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/git_absent_titre"
                    android:textColor="@color/sur"
                    style="@style/Txt.Sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/git_absent_corps"
                    android:textColor="@color/sur_var"
                    style="@style/Txt.BodyS" />
            </LinearLayout>

            <!-- Carte statut : pastille sc2, branche, remote, pill ahead/behind -->
            <LinearLayout
                android:id="@+id/git_status_card"
                style="@style/Carte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="@dimen/pastille_cote"
                        android:layout_height="@dimen/pastille_cote"
                        android:background="@drawable/fond_pastille_sc2">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_code"
                            android:tint="@color/sur_sc2" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/git_branch_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/git_branch"
                            android:textColor="@color/sur"
                            style="@style/Txt.Sm" />

                        <TextView
                            android:id="@+id/git_remote_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="@string/git_sans_suivi"
                            android:textColor="@color/sur_var"
                            style="@style/Txt.BodyS" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/git_ahead_behind_text"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/pill_hauteur"
                        android:background="@drawable/fond_pill_ok"
                        android:text="@string/git_ahead_behind"
                        android:textColor="@color/ok"
                        android:textSize="@dimen/txt_pill"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Comptes : modifiés / nouveaux / supprimés -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/git_count_modified"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/pill_hauteur"
                        android:background="@drawable/fond_pill_warn"
                        android:text="@string/git_modifies"
                        android:textColor="@color/alerte"
                        android:textSize="@dimen/txt_pill"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/git_count_added"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/pill_hauteur"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fond_pill_ok"
                        android:text="@string/git_nouveaux"
                        android:textColor="@color/ok"
                        android:textSize="@dimen/txt_pill"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/git_count_removed"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/pill_hauteur"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fond_pill_err"
                        android:text="@string/git_supprimes"
                        android:textColor="@color/erreur"
                        android:textSize="@dimen/txt_pill"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Eyebrow Modifications -->
            <TextView
                android:id="@+id/git_changes_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/git_section_modifications"
                style="@style/Txt.Eyebrow"
                android:visibility="gone" />

            <!-- Carte fichiers : rangées + bloc diff coloré -->
            <LinearLayout
                android:id="@+id/git_changes_card"
                style="@style/Carte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/git_files_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Diff (lignes err-soft / ok-soft, construites par le fragment) -->
                <LinearLayout
                    android:id="@+id/git_diff_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/git_clean_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/git_rien_propre"
                android:textColor="@color/sur_var"
                style="@style/Txt.BodyS"
                android:visibility="gone" />

            <!-- Eyebrow Historique -->
            <TextView
                android:id="@+id/git_log_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/git_section_historique"
                style="@style/Txt.Eyebrow"
                android:visibility="gone" />

            <!-- Carte commits (rangées construites par le fragment) -->
            <LinearLayout
                android:id="@+id/git_log_card"
                style="@style/Carte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/git_log_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Carte commit : label + champ + 2 chips 44dp -->
            <LinearLayout
                android:id="@+id/git_commit_card"
                style="@style/Carte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/git_commit_message_hint"
                    android:textColor="@color/sur"
                    style="@style/Txt.Label" />

                <EditText
                    android:id="@+id/git_commit_message"
                    style="@style/Champ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:importantForAutofill="no"
                    android:hint="@string/git_commit_message_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/git_stage_button"
                        style="@style/Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/git_stage_button"
                        android:textColor="@color/sur"
                        android:textSize="@dimen/chip_txt"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/git_commit_button"
                        style="@style/Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:background="@drawable/fond_chip_on"
                        android:text="@string/git_commit_button"
                        android:textColor="@color/sur_sc2"
                        android:textSize="@dimen/chip_txt"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Clonage (popup ancrée de l'accueil, posée ici comme carte sc_low) -->
            <LinearLayout
                android:id="@+id/git_clone_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/fond_carte_bas"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/git_clonage_section_titre"
                    style="@style/Txt.Eyebrow" />

                <EditText
                    android:id="@+id/git_clone_url"
                    style="@style/Champ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:inputType="textUri"
                    android:importantForAutofill="no"
                    android:hint="@string/git_clonage_url_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/git_clone_button"
                        style="@style/Chip"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/git_clonage_button"
                        android:textColor="@color/sur"
                        android:textSize="@dimen/chip_txt"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/git_clonage_detection"
                        android:textColor="@color/sur_var"
                        style="@style/Txt.BodyS" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
