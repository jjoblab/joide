<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille « Symboles du projet » (lot L10) : recherche par préfixe dans
     l'index (classes, méthodes, champs) ; tap = saut à la ligne. Repli honnête
     tant que l'index n'est pas prêt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/symboles_titre"
        android:textColor="@color/sur"
        style="@style/Txt.Xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/symboles_sous_titre"
        style="@style/Txt.BodyS" />

    <EditText
        android:id="@+id/symboles_champ"
        style="@style/Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:importantForAutofill="no"
        android:inputType="text"
        android:hint="@string/symboles_hint" />

    <!-- État : préparation de l'index / aucun symbole -->
    <TextView
        android:id="@+id/symboles_etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Résultats (rendu en code) -->
    <LinearLayout
        android:id="@+id/symboles_liste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />
</LinearLayout>
