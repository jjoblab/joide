<?xml version="1.0" encoding="utf-8"?>
<!--
  Journal d'activité (lot L10, d'après BuildActivity + DaemonCrashNote + la
  visionneuse de la référence — REF-130/131) : la chronologie fusionnée —
  builds de l'atelier (ActivityLog), passes d'indexation, rapports de
  plantage (core-diag, ADR-021) — le tap déplie le détail/la trace.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/activity_back"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/commun_retour"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            app:tint="@color/sur_var" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/activite_titre"
            android:textColor="@color/sur"
            style="@style/Txt.Xl" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/activity_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
