<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Fichiers du tiroir gauche (Lot 2) : barre d'outils (tout replier,
     tout déplier, suivre le fichier actif, actualiser), arborescence réelle
     sur core-files (rangées file_tree_row), actions basses Nouveau +
     Corbeille. Les états (chargement, erreur, dossier vide) s'insèrent dans
     l'arbre — jamais d'état muet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Outils de l'arbre (studio : icônes 30dp, « suivre » actif par défaut) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/tree_collapse_all"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/tiroir_replier_tout"
            android:src="@drawable/ic_replier_tout"
            android:scaleType="centerInside"
            app:tint="@color/sur_var" />

        <ImageButton
            android:id="@+id/tree_expand_all"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/tiroir_deplier_tout"
            android:src="@drawable/ic_deplier_tout"
            android:scaleType="centerInside"
            app:tint="@color/sur_var" />

        <ImageButton
            android:id="@+id/tree_follow"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/tiroir_suivre"
            android:src="@drawable/ic_suivre"
            android:scaleType="centerInside"
            app:tint="@color/primaire" />

        <ImageButton
            android:id="@+id/tree_refresh"
            style="@style/IconBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/tiroir_actualiser"
            android:src="@drawable/ic_actualiser"
            android:scaleType="centerInside"
            app:tint="@color/sur_var" />
    </LinearLayout>

    <!-- Arborescence réelle (rangées guides + chevron + icône + décorations) -->
    <ScrollView
        android:id="@+id/tree_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/files_tree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <!-- Actions basses (studio : Nouveau + corbeille, chips 32dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tree_new_file"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/atelier_nouveau_fichier"
            android:textColor="@color/sur"
            android:textSize="@dimen/chip_txt"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tree_delete"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/atelier_corbeille"
            android:textColor="@color/sur"
            android:textSize="@dimen/chip_txt"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
