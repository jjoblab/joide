<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Files du tiroir gauche (Lot 0) : arborescence déplacée telle
     quelle de WorkbenchFragment — ScrollView + rangées indentées, actions
     basses Nouveau + Corbeille (honnêtes). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Arborescence (rangées indentées, dossier primaire / fichier contour) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/files_tree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp" />
    </ScrollView>

    <!-- Actions basses (studio : Nouveau + corbeille, chips 32dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tree_new_file"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/atelier_nouveau_fichier"
            android:textColor="@color/sur"
            android:textSize="@dimen/chip_txt"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tree_delete"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/atelier_corbeille"
            android:textColor="@color/sur"
            android:textSize="@dimen/chip_txt"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
