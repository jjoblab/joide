<?xml version="1.0" encoding="utf-8"?>
<!--
  Feuille « Ajouter une dépendance » (lot L10, d'après DependenciesScreen de
  la référence — REF-129) : recherche en ligne Maven Central (debounce 320 ms,
  coordonnée directe, version), cible module, portée ; fichier local = limite
  honnête (F-07) ; Google Maven n'est PAS interrogé (dit).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dep_ajouter_titre"
        android:textColor="@color/sur"
        style="@style/Txt.Xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dep_ajouter_sous_titre"
        style="@style/Txt.BodyS" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/dep_ajouter_recherche"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <EditText
        android:id="@+id/dep_champ"
        style="@style/Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:hint="@string/dep_ajouter_hint" />

    <!-- Résultats de recherche / versions d'une coordonnée (rendu en code) -->
    <LinearLayout
        android:id="@+id/dep_resultats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

    <!-- État de la recherche (aucun résultat / index injoignable / recherche…) -->
    <TextView
        android:id="@+id/dep_etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Fichier local : limite honnête (forge.json ne porte pas encore les
         dépendances de fichier local — demande F-07 ouverte). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="14dp"
        android:text="@string/dep_fichier_local_limite"
        android:textSize="12.5sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/sur_conteneur_erreur"
        android:background="@drawable/fond_carte_alerte" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/dep_cible"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dep_modules"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/dep_portee"
        android:textColor="@color/sur"
        style="@style/Txt.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dep_portees"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/dep_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/erreur"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dep_ajouter_bouton"
        style="@style/Cta"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dep_ajouter_bouton"
            android:textColor="@color/sur_primaire"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
